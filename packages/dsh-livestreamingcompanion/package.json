{
  "name": "dsh-livestreamingcompanion",
  "version": "0.0.1",
  "description": "Let your DeepSeek Harness agent go live on Bilibili: reads the room, thanks gifts, welcomes viewers, remembers regulars, and talks with its own voice on a stage you can skin.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "stage",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "livestream",
    "bilibili",
    "vtuber"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  }
}
